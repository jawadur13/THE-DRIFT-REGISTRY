---
interface Props {
  nav?: string;
}
const { nav } = Astro.props;

const links = [
  { key: 'registry', href: '/registry', label: 'Registry' },
  { key: 'drift', href: '/drift', label: 'Simulator' },
  { key: 'gyres', href: '/gyres', label: 'Gyres' },
  { key: 'report', href: '/report', label: 'Report a find' },
  { key: 'about', href: '/about', label: 'The Office' },
];
---

<header class="masthead">
  <div class="wrap-wide masthead__in">
    <a class="brand" href="/" aria-label="The Drift Registry, home">
      {/* A drift bottle seen from above, with its wake. */}
      <svg class="brand__mark" viewBox="0 0 24 24" aria-hidden="true" fill="none">
        <circle cx="12" cy="12" r="10.2" stroke="currentColor" stroke-width="1.1" opacity=".38" />
        <circle cx="12" cy="12" r="6.2" stroke="currentColor" stroke-width="1.1" opacity=".62" />
        <circle cx="12" cy="12" r="2.1" fill="currentColor" />
        <path d="M12 1.8v3.2M12 19v3.2M1.8 12h3.2M19 12h3.2" stroke="currentColor" stroke-width="1.1" />
      </svg>
      <span>
        <span class="brand__name">The Drift Registry</span><br />
        <span class="brand__sub">Office of Pelagic Recovery</span>
      </span>
    </a>

    <nav class="nav scroll-fade" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} aria-current={nav === l.key ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <button
        class="icon-btn"
        id="theme-toggle"
        type="button"
        aria-label="Switch to night watch"
        title="Switch theme"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" fill="none">
          <circle cx="8" cy="8" r="3.4" fill="currentColor" class="tt-sun" />
          <g class="tt-rays" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
            <path d="M8 .9v2M8 13.1v2M.9 8h2M13.1 8h2M2.9 2.9l1.4 1.4M11.7 11.7l1.4 1.4M13.1 2.9l-1.4 1.4M4.3 11.7l-1.4 1.4" />
          </g>
          <path
            class="tt-moon"
            d="M11.4 9.6A4.6 4.6 0 0 1 6 4.2a4.6 4.6 0 1 0 5.4 5.4Z"
            fill="currentColor"
          />
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .masthead__in {
    padding-block: 0.4rem;
  }

  .brand span {
    line-height: 1.25;
  }

  @media (max-width: 34rem) {
    .brand__sub {
      display: none;
    }
  }

  /* Sun by day, moon by night. */
  :global(:root[data-theme='chart']) .tt-moon {
    display: none;
  }
  :global(:root[data-theme='night']) .tt-sun,
  :global(:root[data-theme='night']) .tt-rays {
    display: none;
  }

  .nav {
    overflow-x: auto;
    min-width: 0;
    scrollbar-width: none;
    padding-block: 0.15rem;
    -ms-overflow-style: none;
  }
  .nav::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 52rem) {
    .masthead__in {
      flex-wrap: wrap;
      gap: 0.4rem var(--sp-4);
    }
    .nav {
      width: 100%;
      margin-left: 0;
      border-top: 1px solid var(--rule-soft);
      padding-top: 0.35rem;
      justify-content: flex-start;
      gap: 1rem;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');

  function sync() {
    if (!btn) return;
    const night = root.dataset.theme === 'night';
    btn.setAttribute('aria-label', night ? 'Switch to chart' : 'Switch to night watch');
  }

  btn?.addEventListener('click', () => {
    const night = root.dataset.theme === 'night';
    root.dataset.theme = night ? 'chart' : 'night';
    try {
      localStorage.setItem('dr-theme', root.dataset.theme);
    } catch {
      /* storage blocked; the choice simply will not persist */
    }
    sync();
    // Let canvases repaint with the new palette.
    window.dispatchEvent(new CustomEvent('dr:theme'));
  });

  sync();
</script>
